{
  "version": 2.1,
  "orbs": {
    "qqq-orb": "kingsrook/qqq-orb@__ORB_VERSION__"
  },
  "workflows": {
    "verify-and-smoke": {
      "jobs": [
        {
          "qqq-orb/all_verify": {
            "name": "build-and-test"
          }
        },
        {
          "qqq-orb/all_smoke": {
            "name": "core",
            "profile": "core",
            "requires": [
              "build-and-test"
            ]
          }
        },
        {
          "qqq-orb/all_smoke": {
            "name": "full",
            "profile": "full",
            "requires": [
              "build-and-test"
            ]
          }
        }
      ]
    }
  }
}
