{
  "version": 2.1,
  "jobs": {
    "build-and-test": {
      "machine": {
        "image": "ubuntu-2204:current"
      },
      "resource_class": "large",
      "environment": {
        "MAVEN_OPTS": "-Xmx2048m"
      },
      "steps": [
        "checkout",
        {
          "qqq-orb/install_java": {
            "java_version": "21"
          }
        },
        "qqq-orb/mvn_cache_restore",
        {
          "run": {
            "name": "Verify application, integration tests, quality and coverage",
            "command": "mvn clean verify -B -T4 --update-snapshots --no-transfer-progress"
          }
        },
        "qqq-orb/mvn_cache_save",
        {
          "store_test_results": {
            "path": "target/surefire-reports"
          }
        },
        {
          "store_test_results": {
            "path": "target/failsafe-reports"
          }
        },
        {
          "store_artifacts": {
            "path": "target/voyage.jar",
            "destination": "app.jar"
          }
        },
        {
          "store_artifacts": {
            "path": "target/site",
            "destination": "quality-and-coverage"
          }
        },
        {
          "persist_to_workspace": {
            "root": ".",
            "paths": [
              "target/classes",
              "target/test-classes",
              "target/surefire-reports",
              "target/voyage.jar",
              "target/site",
              "target/jacoco.exec",
              "Dockerfile",
              "pom.xml",
              "src",
              ".config",
              "sonar-project.properties"
            ]
          }
        }
      ]
    },
    "secrets-scan": {
      "docker": [
        {
          "image": "cimg/base:current"
        }
      ],
      "resource_class": "small",
      "steps": [
        "checkout",
        {
          "run": {
            "name": "Install Gitleaks",
            "command": "wget -q https://github.com/gitleaks/gitleaks/releases/download/v8.21.2/gitleaks_8.21.2_linux_x64.tar.gz\ntar -xzf gitleaks_8.21.2_linux_x64.tar.gz\nchmod +x gitleaks\n"
          }
        },
        {
          "run": {
            "name": "Run Gitleaks",
            "command": "./gitleaks detect --source . --config .gitleaks.toml --verbose"
          }
        }
      ]
    },
    "sast-scan": {
      "docker": [
        {
          "image": "returntocorp/semgrep:latest"
        }
      ],
      "resource_class": "medium",
      "steps": [
        "checkout",
        {
          "run": {
            "name": "Semgrep SAST Scan",
            "command": "semgrep scan \\\n  --config auto \\\n  --config p/java \\\n  --config p/owasp-top-ten \\\n  --config p/security-audit \\\n  --error \\\n  --json --output semgrep-results.json \\\n  . || true\nsemgrep scan \\\n  --config auto \\\n  --config p/java \\\n  --config p/owasp-top-ten \\\n  . 2>&1 | tee semgrep-report.txt || true\n"
          }
        },
        {
          "store_artifacts": {
            "path": "semgrep-results.json",
            "destination": "semgrep-results.json"
          }
        },
        {
          "store_artifacts": {
            "path": "semgrep-report.txt",
            "destination": "semgrep-report.txt"
          }
        }
      ]
    },
    "security-scan": {
      "machine": {
        "image": "ubuntu-2204:current"
      },
      "resource_class": "medium",
      "steps": [
        {
          "attach_workspace": {
            "at": "."
          }
        },
        {
          "restore_cache": {
            "keys": [
              "voyage-trivy-v0760-"
            ]
          }
        },
        {
          "run": {
            "name": "Scan verified application dependencies",
            "no_output_timeout": "15m",
            "command": "set -euo pipefail\ntest -s target/voyage.jar\nmkdir -p \"$HOME/.cache/trivy\" target/security-reports\ndocker run --rm \\\n  -v \"$PWD/target/voyage.jar:/scan/voyage.jar:ro\" \\\n  -v \"$PWD/target/security-reports:/reports\" \\\n  -v \"$HOME/.cache/trivy:/root/.cache/\" \\\n  aquasec/trivy:0.76.0@sha256:2416d1f74045b57274df1a340eee6b510cacd73c66a6ccb8da092b117eb7d222 rootfs \\\n  --scanners vuln --severity HIGH,CRITICAL --exit-code 1 \\\n  --list-all-pkgs --format json --output /reports/dependencies.json /scan\n"
          }
        },
        {
          "save_cache": {
            "key": "voyage-trivy-v0760-{{ epoch }}",
            "paths": [
              "~/.cache/trivy"
            ]
          }
        },
        {
          "store_artifacts": {
            "path": "target/security-reports",
            "destination": "dependency-security"
          }
        }
      ]
    },
    "sonar-scan": {
      "machine": {
        "image": "ubuntu-2204:current"
      },
      "resource_class": "medium",
      "steps": [
        "checkout",
        {
          "attach_workspace": {
            "at": "."
          }
        },
        {
          "qqq-orb/install_java": {
            "java_version": "21"
          }
        },
        "qqq-orb/mvn_cache_restore",
        {
          "run": {
            "name": "SonarCloud Analysis",
            "command": "mvn -B sonar:sonar \\\n  -Dsonar.projectKey=qrun-io_voyage \\\n  -Dsonar.organization=qrun-io \\\n  -Dsonar.host.url=https://sonarcloud.io \\\n  -Dsonar.token=${SONAR_TOKEN} \\\n  -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \\\n  -Dsonar.scm.disabled=true\n"
          }
        }
      ]
    },
    "docker-build": {
      "machine": {
        "image": "ubuntu-2204:current"
      },
      "resource_class": "medium",
      "steps": [
        "checkout",
        {
          "attach_workspace": {
            "at": "."
          }
        },
        {
          "run": {
            "name": "Build Docker Image",
            "command": "docker build -t voyage:${CIRCLE_SHA1:0:7} .\ndocker tag voyage:${CIRCLE_SHA1:0:7} voyage:latest\n"
          }
        },
        {
          "run": {
            "name": "Trivy Container Scan",
            "command": "TRIVY_VERSION=\"0.58.2\"\ndocker run --rm \\\n  -v /var/run/docker.sock:/var/run/docker.sock \\\n  aquasec/trivy:${TRIVY_VERSION} image \\\n  --severity CRITICAL,HIGH \\\n  --exit-code 1 \\\n  --ignore-unfixed \\\n  voyage:${CIRCLE_SHA1:0:7}\n"
          }
        },
        {
          "run": {
            "name": "Push to GitHub Packages",
            "command": "echo \"${GHCR_TOKEN}\" | docker login ghcr.io -u \"${GHCR_USERNAME}\" --password-stdin\ndocker tag voyage:${CIRCLE_SHA1:0:7} ghcr.io/qrun-io/voyage:${CIRCLE_SHA1:0:7}\ndocker tag voyage:latest ghcr.io/qrun-io/voyage:latest\ndocker push ghcr.io/qrun-io/voyage:${CIRCLE_SHA1:0:7}\ndocker push ghcr.io/qrun-io/voyage:latest\nif [ \"${CIRCLE_BRANCH}\" = \"develop\" ] || [ \"${CIRCLE_BRANCH}\" = \"main\" ]; then\n  docker tag voyage:${CIRCLE_SHA1:0:7} ghcr.io/qrun-io/voyage:${CIRCLE_BRANCH}\n  docker push ghcr.io/qrun-io/voyage:${CIRCLE_BRANCH}\n  echo \"Pushed ghcr.io/qrun-io/voyage:${CIRCLE_BRANCH}\"\nfi\necho \"Pushed ghcr.io/qrun-io/voyage:${CIRCLE_SHA1:0:7}\"\n"
          }
        }
      ]
    },
    "sbom": {
      "docker": [
        {
          "image": "cimg/openjdk:21.0"
        }
      ],
      "resource_class": "small",
      "steps": [
        "checkout",
        "qqq-orb/mvn_cache_restore",
        {
          "run": {
            "name": "Generate SBOM (CycloneDX)",
            "command": "mvn org.cyclonedx:cyclonedx-maven-plugin:makeAggregateBom \\\n  -DoutputFormat=json \\\n  -DoutputName=sbom \\\n  -B\n"
          }
        },
        {
          "store_artifacts": {
            "path": "target/sbom.json",
            "destination": "sbom.json"
          }
        }
      ]
    },
    "release-please": {
      "docker": [
        {
          "image": "cimg/node:20.11"
        }
      ],
      "resource_class": "small",
      "steps": [
        "checkout",
        {
          "run": {
            "name": "Run release-please",
            "command": "set -euo pipefail\nnpx release-please github-release \\\n  --token=${GITHUB_TOKEN} \\\n  --target-branch=main \\\n  --repo-url=QRun-IO/voyage \\\n  --release-type=maven \\\n  --package-name=voyage\nnpx release-please release-pr \\\n  --token=${GITHUB_TOKEN} \\\n  --target-branch=main \\\n  --repo-url=QRun-IO/voyage \\\n  --release-type=maven \\\n  --package-name=voyage\n"
          }
        }
      ]
    }
  },
  "workflows": {
    "pull-request": {
      "jobs": [
        {
          "build-and-test": {
            "filters": {
              "branches": {
                "ignore": [
                  "main",
                  "develop",
                  "/^release\\/.*/"
                ]
              }
            }
          }
        },
        {
          "secrets-scan": {
            "filters": {
              "branches": {
                "ignore": [
                  "main",
                  "develop",
                  "/^release\\/.*/"
                ]
              }
            }
          }
        },
        {
          "sast-scan": {
            "filters": {
              "branches": {
                "ignore": [
                  "main",
                  "develop",
                  "/^release\\/.*/"
                ]
              }
            }
          }
        },
        {
          "security-scan": {
            "requires": [
              "build-and-test"
            ],
            "filters": {
              "branches": {
                "ignore": [
                  "main",
                  "develop",
                  "/^release\\/.*/"
                ]
              }
            }
          }
        }
      ]
    },
    "develop": {
      "jobs": [
        {
          "build-and-test": {
            "filters": {
              "branches": {
                "only": "develop"
              }
            }
          }
        },
        {
          "secrets-scan": {
            "filters": {
              "branches": {
                "only": "develop"
              }
            }
          }
        },
        {
          "sast-scan": {
            "filters": {
              "branches": {
                "only": "develop"
              }
            }
          }
        },
        {
          "security-scan": {
            "requires": [
              "build-and-test"
            ],
            "filters": {
              "branches": {
                "only": "develop"
              }
            }
          }
        },
        {
          "sonar-scan": {
            "context": [
              "sonarcloud"
            ],
            "requires": [
              "build-and-test"
            ],
            "filters": {
              "branches": {
                "only": "develop"
              }
            }
          }
        },
        {
          "sbom": {
            "context": [
              "github"
            ],
            "requires": [
              "build-and-test"
            ],
            "filters": {
              "branches": {
                "only": "develop"
              }
            }
          }
        },
        {
          "docker-build": {
            "context": [
              "ghcr"
            ],
            "requires": [
              "build-and-test",
              "secrets-scan",
              "sast-scan",
              "security-scan"
            ],
            "filters": {
              "branches": {
                "only": "develop"
              }
            }
          }
        }
      ]
    },
    "release": {
      "jobs": [
        {
          "build-and-test": {
            "filters": {
              "branches": {
                "only": [
                  "main",
                  "/^release\\/.*/"
                ]
              }
            }
          }
        },
        {
          "secrets-scan": {
            "filters": {
              "branches": {
                "only": [
                  "main",
                  "/^release\\/.*/"
                ]
              }
            }
          }
        },
        {
          "sast-scan": {
            "filters": {
              "branches": {
                "only": [
                  "main",
                  "/^release\\/.*/"
                ]
              }
            }
          }
        },
        {
          "security-scan": {
            "requires": [
              "build-and-test"
            ],
            "filters": {
              "branches": {
                "only": [
                  "main",
                  "/^release\\/.*/"
                ]
              }
            }
          }
        },
        {
          "sonar-scan": {
            "context": [
              "sonarcloud"
            ],
            "requires": [
              "build-and-test"
            ],
            "filters": {
              "branches": {
                "only": [
                  "main",
                  "/^release\\/.*/"
                ]
              }
            }
          }
        },
        {
          "sbom": {
            "context": [
              "github"
            ],
            "requires": [
              "build-and-test"
            ],
            "filters": {
              "branches": {
                "only": [
                  "main",
                  "/^release\\/.*/"
                ]
              }
            }
          }
        },
        {
          "docker-build": {
            "context": [
              "ghcr"
            ],
            "requires": [
              "build-and-test",
              "secrets-scan",
              "sast-scan",
              "security-scan"
            ],
            "filters": {
              "branches": {
                "only": [
                  "main",
                  "/^release\\/.*/"
                ]
              }
            }
          }
        },
        {
          "munitor/update_cd_repo": {
            "context": [
              "github"
            ],
            "requires": [
              "docker-build"
            ],
            "filters": {
              "branches": {
                "only": "main"
              }
            },
            "name": "update-cd-repo",
            "cd_repo": "KofTwentyTwo/cluster-gitops",
            "environment": "prod",
            "cd_format": "kustomize",
            "cd_image_name": "ghcr.io/qrun-io/voyage",
            "cd_path": "tenants/voyage/kustomization.yaml",
            "pre-steps": [
              {
                "run": {
                  "name": "Use the image published for this commit",
                  "command": "set -euo pipefail\n[[ \"$CIRCLE_SHA1\" =~ ^[0-9a-f]{40}$ ]]\nprintf \"export PROJECT_VERSION='%s'\\n\" \"${CIRCLE_SHA1:0:7}\" >> \"$BASH_ENV\"\n"
                }
              }
            ]
          }
        },
        {
          "release-please": {
            "context": [
              "github"
            ],
            "requires": [
              "docker-build"
            ],
            "filters": {
              "branches": {
                "only": "main"
              }
            }
          }
        }
      ]
    }
  },
  "orbs": {
    "qqq-orb": "kingsrook/qqq-orb@__ORB_VERSION__",
    "munitor": "kof22/munitor@0.3.11"
  }
}
