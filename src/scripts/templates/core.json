{
  "version": 2.1,
  "parameters": {
    "mongo_bind_diagnostics": {
      "type": "boolean",
      "default": false
    },
    "next_acceptance_bundle_url": {
      "type": "string",
      "default": ""
    },
    "next_acceptance_bundle_sha256": {
      "type": "string",
      "default": ""
    },
    "next_acceptance_receipt_sha256": {
      "type": "string",
      "default": ""
    }
  },
  "orbs": {
    "qqq-orb": "kingsrook/qqq-orb@0.6.9"
  },
  "commands": {
    "start-mongo-bind-trace": {
      "steps": [
        "checkout",
        {
          "run": {
            "name": "Prepare owned Mongo socket diagnostics",
            "command": "if sudo apt-get update -qq && sudo apt-get install -y -qq strace &&\n   command -v nsenter ss && sudo install -d -m 755 /tmp/qqq-mongo-bind-diagnostics &&\n   sudo strace -e trace=bind -o /tmp/qqq-mongo-bind-diagnostics/preflight.log true; then\n  printf 'export QQQ_MONGO_TRACE_RUN=%q\\n' \"$CIRCLE_WORKFLOW_JOB_ID\" >> \"$BASH_ENV\"\nelse\n  echo 'Mongo tracing preflight unavailable; continue original Maven checks.'\nfi\n"
          }
        },
        {
          "run": {
            "name": "Observe only this job's labelled Mongo fixtures",
            "background": true,
            "command": "test -n \"${QQQ_MONGO_TRACE_RUN:-}\" || exit 0\nsudo --preserve-env=CIRCLECI,CIRCLE_WORKFLOW_JOB_ID,QQQ_MONGO_TRACE_RUN python3 .circleci/trace-mongo-bind.py\n"
          }
        }
      ]
    },
    "stop-mongo-bind-trace": {
      "steps": [
        {
          "run": {
            "name": "Finish owned Mongo socket diagnostics",
            "when": "always",
            "command": "test -n \"${QQQ_MONGO_TRACE_RUN:-}\" || exit 0\nsudo touch /tmp/qqq-mongo-bind-diagnostics/stop || echo 'Could not signal Mongo collector.'\nfor attempt in $(seq 1 20); do\n  test ! -f /tmp/qqq-mongo-bind-diagnostics/result.json || break\n  sleep 1\ndone\nsudo chmod -R a+rX /tmp/qqq-mongo-bind-diagnostics || echo 'Could not make all diagnostic artifacts readable.'\nif test -f /tmp/qqq-mongo-bind-diagnostics/result.json; then\n  cat /tmp/qqq-mongo-bind-diagnostics/result.json\nelse\n  echo 'Mongo diagnostic receipt missing; socket ownership remains unproven.'\nfi\n"
          }
        },
        {
          "store_artifacts": {
            "path": "/tmp/qqq-mongo-bind-diagnostics",
            "destination": "mongo-bind-diagnostics"
          }
        }
      ]
    },
    "configure-package-install": {
      "steps": [
        {
          "run": {
            "name": "Keep package installation unattended",
            "command": "# These build machines are discarded after the job.\n# Use Ubuntu's archive mirror, which also carries the signed security suite.\nsudo sed -i 's|http://security.ubuntu.com/ubuntu|https://archive.ubuntu.com/ubuntu|g' /etc/apt/sources.list\nsudo install -d /etc/needrestart/conf.d\nprintf '%s\\n' '$nrconf{restart} = \"l\";' | sudo tee /etc/needrestart/conf.d/99-qqq-ci.conf >/dev/null\n"
          }
        }
      ]
    },
    "store-sample-results": {
      "steps": [
        {
          "run": {
            "name": "Collect JUnit test reports",
            "when": "always",
            "command": "mkdir -p qqq-sample-project/target/junit-results\nfor report in qqq-sample-project/target/surefire-reports/TEST-*.xml qqq-sample-project/target/failsafe-reports/TEST-*.xml; do\n  if [ -f \"$report\" ]; then\n    cp \"$report\" qqq-sample-project/target/junit-results/\n  fi\ndone\n"
          }
        },
        {
          "store_test_results": {
            "path": "qqq-sample-project/target/junit-results"
          }
        },
        {
          "store_test_results": {
            "path": "qqq-sample-project/target/starter-application-junit"
          }
        },
        {
          "store_artifacts": {
            "path": "qqq-sample-project/target/browser-acceptance"
          }
        },
        {
          "store_artifacts": {
            "path": "qqq-sample-project/target/display-widgets"
          }
        },
        {
          "store_artifacts": {
            "path": "qqq-sample-project/target/widget-controls"
          }
        },
        {
          "store_artifacts": {
            "path": "qqq-sample-project/target/feature-coverage-result.json"
          }
        },
        {
          "store_artifacts": {
            "path": "qqq-sample-project/target/next-acceptance-stage.json"
          }
        }
      ]
    },
    "persist-sample-evidence": {
      "parameters": {
        "shard": {
          "type": "string"
        }
      },
      "steps": [
        {
          "run": {
            "name": "Collect sample evidence for the coverage gate",
            "when": "always",
            "command": "mkdir -p /tmp/sample-evidence/<< parameters.shard >>\nfor directory in surefire-reports failsafe-reports starter-application-junit browser-acceptance display-widgets widget-controls; do\n  if [ -d \"qqq-sample-project/target/$directory\" ]; then\n    cp -R \"qqq-sample-project/target/$directory\" /tmp/sample-evidence/<< parameters.shard >>/\n  fi\ndone\n"
          }
        },
        {
          "persist_to_workspace": {
            "root": "/tmp/sample-evidence",
            "paths": [
              "<< parameters.shard >>"
            ]
          }
        }
      ]
    }
  },
  "jobs": {
    "esb_broker_conformance": {
      "machine": {
        "image": "ubuntu-2204:current"
      },
      "resource_class": "large",
      "steps": [
        "configure-package-install",
        "qqq-orb/install_java",
        "checkout",
        "qqq-orb/mvn_build",
        {
          "run": {
            "name": "Verify Docker is available for broker conformance",
            "command": "docker info"
          }
        },
        {
          "run": {
            "name": "Run Artemis and RabbitMQ broker conformance",
            "command": "mvn -B -s /tmp/circleci/mvn-settings.xml -pl qqq-esb -am -Desb.conformance.skip=false clean verify"
          }
        },
        {
          "run": {
            "name": "Require broker restart conformance on Linux",
            "command": "python3 - \\<<'PY'\nfrom pathlib import Path\nfrom xml.etree import ElementTree\n\nreports = Path(\"qqq-esb/target/failsafe-reports\")\nfor broker in (\"Artemis\", \"RabbitMQ\"):\n    path = reports / f\"TEST-com.kingsrook.qqq.esb.conformance.{broker}ConformanceIT.xml\"\n    suite = ElementTree.parse(path).getroot()\n    matches = [case for case in suite.findall(\"testcase\") if case.get(\"name\") == \"reconnectsAfterBrokerRestart\"]\n    assert len(matches) == 1, f\"{broker}: broker restart test missing\"\n    assert matches[0].find(\"skipped\") is None, f\"{broker}: broker restart test was skipped\"\nPY\n"
          }
        },
        {
          "store_test_results": {
            "path": "qqq-esb/target/failsafe-reports"
          }
        }
      ]
    },
    "sample_bootstrap_source": {
      "executor": "qqq-orb/java",
      "steps": [
        "configure-package-install",
        "qqq-orb/install_java",
        "checkout",
        {
          "run": {
            "name": "Check bootstrap runner and ledger regressions",
            "command": "python3 qqq-sample-project/test_bootstrap_acceptance.py\npython3 qqq-sample-project/test_feature_coverage.py\n"
          }
        },
        {
          "run": {
            "name": "Prove source bootstrap from an empty Maven cache",
            "command": "python3 qqq-sample-project/bootstrap_acceptance.py --stage source --workdir /tmp/qqq-bootstrap-source"
          }
        },
        {
          "run": {
            "name": "Require current source bootstrap evidence",
            "when": "always",
            "command": "mkdir -p qqq-sample-project/target/bootstrap-evidence qqq-sample-project/target/junit-results\nif [ -f /tmp/qqq-bootstrap-source/acceptance.json ]; then\n  cp /tmp/qqq-bootstrap-source/acceptance.json qqq-sample-project/target/bootstrap-acceptance.json\n  cp /tmp/qqq-bootstrap-source/acceptance.json qqq-sample-project/target/bootstrap-evidence/\nfi\nfor log in /tmp/qqq-bootstrap-source/*.log; do\n  if [ -f \"$log\" ]; then cp \"$log\" qqq-sample-project/target/bootstrap-evidence/; fi\ndone\nfor report in qqq-sample-project/target/surefire-reports/TEST-*.xml qqq-sample-project/target/failsafe-reports/TEST-*.xml; do\n  if [ -f \"$report\" ]; then cp \"$report\" qqq-sample-project/target/junit-results/; fi\ndone\npython3 qqq-sample-project/verify-feature-coverage.py --stage source --require-feature sample.bootstrap\n"
          }
        },
        {
          "persist_to_workspace": {
            "root": "qqq-sample-project/target",
            "paths": [
              "bootstrap-acceptance.json"
            ]
          }
        },
        {
          "store_test_results": {
            "path": "qqq-sample-project/target/junit-results"
          }
        },
        {
          "store_artifacts": {
            "path": "qqq-sample-project/target/bootstrap-evidence"
          }
        },
        {
          "store_artifacts": {
            "path": "qqq-sample-project/target/feature-coverage-result.json"
          }
        }
      ]
    },
    "sample_acceptance": {
      "executor": "qqq-orb/java",
      "steps": [
        "configure-package-install",
        {
          "qqq-orb/install_java": {
            "install_node": true
          }
        },
        "checkout",
        "qqq-orb/mvn_build",
        {
          "run": {
            "name": "Build framework dependencies for the sample",
            "command": "mvn -B -s /tmp/circleci/mvn-settings.xml -Drevision=0.0.0-sample-acceptance -DskipTests -Dspotbugs.skip=true -Dpmd.skip=true clean install"
          }
        },
        {
          "run": {
            "name": "Check out the pinned Material dashboard",
            "command": "git clone https://github.com/QRun-IO/qqq-frontend-material-dashboard.git /tmp/sample-material-dashboard\ngit -C /tmp/sample-material-dashboard checkout --detach 1784e4e8d29c5c9ef8c40ec4f26ca5cdf58b1972\n"
          }
        },
        {
          "restore_cache": {
            "keys": [
              "material-npm-v1-1784e4e8d29c5c9ef8c40ec4f26ca5cdf58b1972-{{ checksum \"/tmp/sample-material-dashboard/package-lock.json\" }}"
            ]
          }
        },
        {
          "run": {
            "name": "Build the pinned Material dashboard against this framework",
            "command": "cd /tmp/sample-material-dashboard\n# Consumers read this installed POM without the build's command-line properties.\npython3 -c '\nfrom pathlib import Path\npom = Path(\"pom.xml\")\ntext = pom.read_text()\nold = \"<qqq.version>4.0.0</qqq.version>\"\nassert text.count(old) == 1, \"Pinned dashboard QQQ version changed\"\npom.write_text(text.replace(old, \"<qqq.version>0.0.0-sample-acceptance</qqq.version>\"))\n'\nnpm ci --legacy-peer-deps --prefer-offline --cache ~/.npm\nCI=true npm test -- --watchAll=false --runInBand\n# Match the accepted production build; existing source-map warnings remain warnings.\nCI=false npm run build\nmkdir -p src/main/resources/material-dashboard\ncp -R build/. src/main/resources/material-dashboard/\n# This internal test dependency is installed only on this build machine.\nmvn -B -s /tmp/circleci/mvn-settings.xml -Dqqq.version=0.0.0-sample-acceptance -Drevision=0.0.0-sample-acceptance -Dgpg.skip=true '-Dtest=*Test' clean install\n"
          }
        },
        {
          "save_cache": {
            "key": "material-npm-v1-1784e4e8d29c5c9ef8c40ec4f26ca5cdf58b1972-{{ checksum \"/tmp/sample-material-dashboard/package-lock.json\" }}",
            "paths": [
              "~/.npm"
            ]
          }
        },
        {
          "run": {
            "name": "Run sample data, HTTP and browser acceptance",
            "command": "python3 -B -m unittest discover -s qqq-sample-project -p 'test_*.py'\n# This QBit is a source-only fixture, installed into this job's local cache.\nmvn -B -s /tmp/circleci/mvn-settings.xml -Drevision=0.0.0-sample-acceptance -DskipTests -f qqq-sample-data-qbit/pom.xml clean install\nmvn -B -s /tmp/circleci/mvn-settings.xml -Drevision=0.0.0-sample-acceptance -Dqqq.version=0.0.0-sample-acceptance -Dqqq.frontend.material-dashboard.version=0.0.0-sample-acceptance -f qqq-sample-project/pom.xml -Pacceptance-tests,data-qbit-acceptance clean verify\n"
          }
        },
        {
          "run": {
            "name": "Run Lambda source acceptance",
            "command": "set -euo pipefail\nmvn -B -s /tmp/circleci/mvn-settings.xml -Drevision=0.0.0-sample-acceptance -pl qqq-middleware-lambda,qqq-utility-lambdas clean verify\nmkdir -p qqq-sample-project/target/surefire-reports\ncp qqq-middleware-lambda/target/surefire-reports/TEST-com.kingsrook.sampleapp.SampleLambdaDispatchAcceptanceTest.xml qqq-sample-project/target/surefire-reports/\ncp qqq-utility-lambdas/target/surefire-reports/TEST-com.kingsrook.sampleapp.SampleSqsUtilityAcceptanceTest.xml qqq-sample-project/target/surefire-reports/\n"
          }
        },
        "store-sample-results",
        {
          "store_test_results": {
            "path": "qqq-middleware-lambda/target/surefire-reports"
          }
        },
        {
          "store_test_results": {
            "path": "qqq-utility-lambdas/target/surefire-reports"
          }
        },
        {
          "persist-sample-evidence": {
            "shard": "sample-core"
          }
        }
      ]
    },
    "sample_multinode_acceptance": {
      "executor": "qqq-orb/java",
      "steps": [
        "configure-package-install",
        "qqq-orb/install_java",
        "checkout",
        "qqq-orb/mvn_build",
        {
          "run": {
            "name": "Build framework dependencies for the sample",
            "command": "mvn -B -s /tmp/circleci/mvn-settings.xml -Drevision=0.0.0-sample-multinode -DskipTests -Dspotbugs.skip=true -Dpmd.skip=true clean install"
          }
        },
        {
          "run": {
            "name": "Run single-node defaults and multi-node (HA) acceptance",
            "command": "mvn -B -s /tmp/circleci/mvn-settings.xml -Drevision=0.0.0-sample-multinode -f qqq-sample-project/pom.xml -Pacceptance-tests \\\n  -Dtest=SampleSingleNodeDefaultsTest -Dsurefire.failIfNoSpecifiedTests=false -Dit.test=SampleMultiNodeIT -Dcoverage.haltOnFailure=false clean verify\n"
          }
        },
        {
          "run": {
            "name": "Require both deployment modes to have run",
            "command": "python3 - \\<<'PY'\nfrom pathlib import Path\nfrom xml.etree import ElementTree\n\ntarget = Path(\"qqq-sample-project/target\")\nfor report, minimum in ((\"surefire-reports/TEST-com.kingsrook.sampleapp.SampleSingleNodeDefaultsTest.xml\", 6),\n                        (\"failsafe-reports/TEST-com.kingsrook.sampleapp.SampleMultiNodeIT.xml\", 11)):\n    suite = ElementTree.parse(target / report).getroot()\n    ran = int(suite.get(\"tests\")) - int(suite.get(\"skipped\"))\n    assert ran >= minimum, f\"{report}: {ran} tests ran, expected {minimum}\"\n    assert int(suite.get(\"failures\")) == 0 and int(suite.get(\"errors\")) == 0, report\nPY\n"
          }
        },
        "store-sample-results"
      ]
    },
    "sample_consumer_acceptance": {
      "executor": "qqq-orb/java",
      "steps": [
        "configure-package-install",
        "qqq-orb/install_java",
        "checkout",
        "qqq-orb/mvn_build",
        {
          "run": {
            "name": "Build framework dependencies for the consumers",
            "command": "mvn -B -s /tmp/circleci/mvn-settings.xml -Drevision=0.0.0-sample-acceptance -DskipTests -Dspotbugs.skip=true -Dpmd.skip=true clean install"
          }
        },
        {
          "run": {
            "name": "Require source-generated starter and application acceptance with live MySQL",
            "no_output_timeout": "30m",
            "command": "set -euo pipefail\nconsumer_root=$(mktemp -d /tmp/qqq-starter-acceptance-XXXXXX)\ntrap 'rm -rf \"$consumer_root\"' EXIT\ngit clone https://github.com/QRun-IO/qqq-app-starter.git \"$consumer_root/starter\"\ngit -C \"$consumer_root/starter\" checkout --detach 2fb62378fa76da1950dc9e67984c18fd0491ae3f\ntest \"$(git -C \"$consumer_root/starter\" rev-parse HEAD)\" = 2fb62378fa76da1950dc9e67984c18fd0491ae3f\ngit clone https://github.com/QRun-IO/qbit-template-application.git \"$consumer_root/template\"\ngit -C \"$consumer_root/template\" fetch origin refs/pull/5/head\ngit -C \"$consumer_root/template\" checkout --detach FETCH_HEAD\ntest \"$(git -C \"$consumer_root/template\" rev-parse HEAD)\" = 70a72a54f4a3024e39d07a7d86c5acf738283286\ndocker pull mysql:8.4\nQQQ_STARTER_SOURCE=\"$consumer_root/starter\" QQQ_TEMPLATE_SOURCE=\"$consumer_root/template\" \\\n  python3 -m unittest discover -s qqq-sample-project/acceptance -p test_starter_application.py -v\npython3 qqq-sample-project/acceptance/run_starter_application.py \\\n  --qqq-source . --starter-source \"$consumer_root/starter\" \\\n  --template-source \"$consumer_root/template\" \\\n  --candidate-version 0.0.0-sample-acceptance \\\n  --maven-repo \"$consumer_root/m2\" --online \\\n  --maven-settings /tmp/circleci/mvn-settings.xml --live-mysql \\\n  --junit-dir qqq-sample-project/target/starter-application-junit\npython3 qqq-sample-project/verify-feature-coverage.py --stage source \\\n  --require-feature train.starter --require-feature train.application\n"
          }
        },
        {
          "run": {
            "name": "Verify generated infrastructure extension in a separate host",
            "command": "git clone https://github.com/QRun-IO/qbit-template-extension.git /tmp/sample-extension-template\ngit -C /tmp/sample-extension-template checkout --detach a3c5b6afddacb9a98a46ffbb9f3e93924c26480a\npython3 qqq-sample-project/acceptance/extension/run_extension.py \\\n  --qqq-source . \\\n  --template-source /tmp/sample-extension-template \\\n  --candidate-version 0.0.0-sample-acceptance \\\n  --maven-settings /tmp/circleci/mvn-settings.xml \\\n  --report-dir qqq-sample-project/target/surefire-reports\n"
          }
        },
        "store-sample-results",
        {
          "persist-sample-evidence": {
            "shard": "sample-consumer"
          }
        }
      ]
    },
    "sample_coverage_gate": {
      "executor": "qqq-orb/java",
      "environment": {
        "QQQ_NEXT_CI_BUNDLE_URL": "<< pipeline.parameters.next_acceptance_bundle_url >>",
        "QQQ_NEXT_BUNDLE_SHA256": "<< pipeline.parameters.next_acceptance_bundle_sha256 >>",
        "QQQ_NEXT_RECEIPT_SHA256": "<< pipeline.parameters.next_acceptance_receipt_sha256 >>"
      },
      "parameters": {
        "require_complete_coverage": {
          "type": "boolean",
          "default": false
        }
      },
      "steps": [
        "checkout",
        {
          "attach_workspace": {
            "at": "qqq-sample-project/target"
          }
        },
        {
          "run": {
            "name": "Combine core and consumer evidence without running Maven clean",
            "command": "cp -R qqq-sample-project/target/sample-core/. qqq-sample-project/target/\ncp -R qqq-sample-project/target/sample-consumer/. qqq-sample-project/target/\n"
          }
        },
        {
          "run": {
            "name": "Stage independently reviewed Next evidence after clean builds",
            "when": "always",
            "command": "python3 -B qqq-sample-project/next_acceptance_ci.py stage"
          }
        },
        {
          "run": {
            "name": "Report sample feature coverage",
            "when": "always",
            "command": "python3 -B qqq-sample-project/next_acceptance_ci.py report"
          }
        },
        {
          "when": {
            "condition": "<< parameters.require_complete_coverage >>",
            "steps": [
              {
                "run": {
                  "name": "Require reviewed source-stage coverage before publication",
                  "when": "always",
                  "command": "python3 -B qqq-sample-project/next_acceptance_ci.py strict"
                }
              }
            ]
          }
        },
        "store-sample-results"
      ]
    }
  },
  "workflows": {
    "test_only": {
      "jobs": [
        {
          "esb_broker_conformance": {
            "context": [
              "qqq-maven-registry-credentials"
            ],
            "filters": {
              "branches": {
                "ignore": "/(develop|release/.*|hotfix/.*|integration.*)/"
              },
              "tags": {
                "only": []
              }
            }
          }
        },
        {
          "sample_bootstrap_source": {
            "filters": {
              "branches": {
                "ignore": "/(develop|release/.*|hotfix/.*|integration.*)/"
              },
              "tags": {
                "only": []
              }
            }
          }
        },
        {
          "sample_acceptance": {
            "name": "sample_acceptance",
            "filters": {
              "branches": {
                "ignore": "/(develop|release/.*|hotfix/.*|integration.*)/"
              },
              "tags": {
                "only": []
              }
            }
          }
        },
        {
          "sample_multinode_acceptance": {
            "name": "sample_multinode_acceptance",
            "filters": {
              "branches": {
                "ignore": "/(develop|release/.*|hotfix/.*|integration.*)/"
              },
              "tags": {
                "only": []
              }
            }
          }
        },
        {
          "sample_consumer_acceptance": {
            "name": "sample_consumer_acceptance",
            "filters": {
              "branches": {
                "ignore": "/(develop|release/.*|hotfix/.*|integration.*)/"
              },
              "tags": {
                "only": []
              }
            }
          }
        },
        {
          "sample_coverage_gate": {
            "name": "sample_coverage_gate",
            "require_complete_coverage": false,
            "requires": [
              "sample_acceptance",
              "sample_multinode_acceptance",
              "sample_consumer_acceptance"
            ],
            "filters": {
              "branches": {
                "ignore": "/(develop|release/.*|hotfix/.*|integration.*)/"
              },
              "tags": {
                "only": []
              }
            }
          }
        },
        {
          "qqq-orb/mvn_test_only": {
            "pre-steps": [
              "configure-package-install",
              {
                "when": {
                  "condition": "<< pipeline.parameters.mongo_bind_diagnostics >>",
                  "steps": [
                    "start-mongo-bind-trace"
                  ]
                }
              }
            ],
            "post-steps": [
              {
                "when": {
                  "condition": "<< pipeline.parameters.mongo_bind_diagnostics >>",
                  "steps": [
                    "stop-mongo-bind-trace"
                  ]
                }
              }
            ],
            "context": [
              "qqq-maven-registry-credentials",
              "build-qqq-sample-app"
            ],
            "filters": {
              "branches": {
                "ignore": "/(develop|release/.*|hotfix/.*|integration.*)/"
              },
              "tags": {
                "only": []
              }
            }
          }
        },
        {
          "qqq-orb/static_analysis": {
            "pre-steps": [
              "configure-package-install"
            ],
            "context": [
              "qqq-maven-registry-credentials"
            ],
            "filters": {
              "branches": {
                "ignore": "/(develop|release/.*|hotfix/.*|integration.*)/"
              },
              "tags": {
                "only": []
              }
            }
          }
        }
      ]
    },
    "publish_snapshot": {
      "jobs": [
        {
          "esb_broker_conformance": {
            "name": "snapshot_esb_broker_conformance",
            "context": [
              "qqq-maven-registry-credentials"
            ],
            "filters": {
              "branches": {
                "only": [
                  "develop"
                ]
              }
            }
