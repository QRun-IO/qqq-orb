{
  "mcp-rag": {
    "repository": "qqq-mcp-rag",
    "sha": "7ff9bc7af7e949eee164efb90e3b4a2b931b2278",
    "events": {
      "push": {
        "branches": [
          "**"
        ]
      },
      "pull_request": {
        "branches": [
          "main"
        ]
      },
      "workflow_dispatch": null
    },
    "workflow": {
      "name": "Build and Publish",
      "env": {
        "REGISTRY": "ghcr.io"
      },
      "jobs": {
        "lint": {
          "name": "Static Analysis",
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "name": "Checkout",
              "uses": "actions/checkout@v4"
            },
            {
              "name": "Set up Java 21",
              "uses": "actions/setup-java@v4",
              "with": {
                "java-version": "21",
                "distribution": "temurin",
                "cache": "maven"
              }
            },
            {
              "name": "Checkstyle",
              "run": "mvn checkstyle:check -q"
            },
            {
              "name": "Compile with Error Prone",
              "run": "mvn compile test-compile -q"
            }
          ]
        },
        "build-and-test": {
          "name": "Build and Test",
          "runs-on": "ubuntu-latest",
          "needs": "lint",
          "steps": [
            {
              "name": "Checkout",
              "uses": "actions/checkout@v4"
            },
            {
              "name": "Set up Java 21",
              "uses": "actions/setup-java@v4",
              "with": {
                "java-version": "21",
                "distribution": "temurin",
                "cache": "maven"
              }
            },
            {
              "name": "Build, test, and verify",
              "env": {
                "QQQ_MCP_VOYAGE_API_KEY": "${{ secrets.QQQ_MCP_VOYAGE_API_KEY }}"
              },
              "run": "mvn verify -q"
            },
            {
              "name": "Upload JAR",
              "uses": "actions/upload-artifact@v4",
              "with": {
                "name": "jar",
                "path": "target/qqq-mcp-rag-*.jar",
                "retention-days": 1
              }
            }
          ]
        },
        "publish": {
          "name": "Publish Container",
          "needs": "build-and-test",
          "runs-on": "ubuntu-latest",
          "if": "github.event_name == 'push' && github.ref == 'refs/heads/main'",
          "permissions": {
            "contents": "read",
            "packages": "write"
          },
          "steps": [
            {
              "name": "Checkout",
              "uses": "actions/checkout@v4"
            },
            {
              "name": "Download JAR",
              "uses": "actions/download-artifact@v4",
              "with": {
                "name": "jar",
                "path": "target/"
              }
            },
            {
              "name": "Log in to Container Registry",
              "uses": "docker/login-action@v3",
              "with": {
                "registry": "${{ env.REGISTRY }}",
                "username": "${{ github.actor }}",
                "password": "${{ secrets.GITHUB_TOKEN }}"
              }
            },
            {
              "name": "Set image name",
              "run": "echo \"IMAGE_NAME=$(echo ${{ github.repository }} | tr '[:upper:]' '[:lower:]')\" >> $GITHUB_ENV"
            },
            {
              "name": "Build and push",
              "uses": "docker/build-push-action@v5",
              "with": {
                "context": ".",
                "push": true,
                "tags": "${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ github.sha }}\n${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:latest\n"
              }
            }
          ]
        }
      }
    }
  },
  "business-db": {
    "repository": "qqq-business-platform",
    "sha": "8af799fce97e972f81f195df969d79a959f71dbc",
    "events": {
      "pull_request": {
        "paths": [
          "db/**",
          "pom.xml",
          ".github/workflows/db-migrations.yml"
        ]
      },
      "push": {
        "branches": [
          "main"
        ],
        "paths": [
          "db/**",
          "pom.xml"
        ]
      }
    },
    "workflow": {
      "name": "Database migrations",
      "jobs": {
        "empty-database-migration": {
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "uses": "actions/checkout@v4"
            },
            {
              "uses": "actions/setup-java@v4",
              "with": {
                "distribution": "temurin",
                "java-version": "21",
                "cache": "maven"
              }
            },
            {
              "name": "Empty PostgreSQL -> migrate -> validate, demo determinism, forward-only policy",
              "run": "mvn -B -pl db verify"
            }
          ]
        }
      }
    }
  }
}
